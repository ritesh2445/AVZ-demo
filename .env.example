# ==============================================================================
# AVZ VAGANZA — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development. Never commit `.env.local`.

# --- Application & Base URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Primary Database (Turso / LibSQL) ---
# For local development: Leave blank to use local SQLite ('file:avz_commerce.db').
# For production deployment:
TURSO_DATABASE_URL="libsql://avz-commerce-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-database-auth-token"

# --- Authentication (Better Auth) ---
# Generate a high-entropy 32-byte secret (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET="generate-a-32-byte-hex-or-base64-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth 2.0 (One-Click Client Login & Registration) ---
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# --- Supabase Auth (Admin Portal Email OTP Delivery & Verification) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Transactional Email (Resend) ---
# Used for administrator OTP access, customer email verification, and password resets
RESEND_API_KEY="re_placeholder_api_key"
EMAIL_FROM_ADDRESS="AVZ Atelier <orders@avzvaganza.com>"
RESEND_FROM_EMAIL="AVZ Vaganza Atelier <onboarding@resend.dev>"

# --- Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# --- Shipping & Logistics (Shiprocket) ---
SHIPROCKET_EMAIL="atelier@avzvaganza.com"
SHIPROCKET_PASSWORD="placeholder_password"
SHIPROCKET_PICKUP_LOCATION="Guwahati_Hub" # Exact nickname from Shiprocket dashboard

# --- Editorial CMS (Sanity) ---
NEXT_PUBLIC_SANITY_PROJECT_ID="placeholder_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_READ_TOKEN="placeholder_token"

# --- Media & Object Storage (Cloudinary) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="placeholder_cloud"
CLOUDINARY_API_KEY="placeholder_api_key"
CLOUDINARY_API_SECRET="placeholder_api_secret"
