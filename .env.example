# ==============================================================================
# AVZ VAGANZA — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development. Never commit `.env.local`.

# --- Application & Base URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- PostgreSQL Database (Neon Serverless) ---
# Direct connection (migrations & schema ops):
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Pooled connection (PgBouncer - serverless runtime):
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET="generate-a-32-byte-hex-or-base64-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# --- Shipping & Logistics (Shiprocket) ---
SHIPROCKET_EMAIL="atelier@avzvaganza.com"
SHIPROCKET_PASSWORD="placeholder_password"
SHIPROCKET_PICKUP_LOCATION="Guwahati_Hub" # Exact nickname from Shiprocket dashboard

# --- Editorial CMS (Sanity) ---
NEXT_PUBLIC_SANITY_PROJECT_ID="placeholder_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_READ_TOKEN="placeholder_token"

# --- Transactional Email (Resend) ---
RESEND_API_KEY="re_placeholder"
EMAIL_FROM_ADDRESS="AVZ Atelier <orders@avzvaganza.com>"

# --- Media & Object Storage (Cloudinary) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="placeholder_cloud"
CLOUDINARY_API_KEY="placeholder_api_key"
CLOUDINARY_API_SECRET="placeholder_api_secret"
