{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avz-vaganza",
  "account_id": "6596fd26db9ad0e646e44edb07a79059",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "AVZ_MEDIA_BUCKET",
      "bucket_name": "avz-media"
    }
  ],
  "routes": [
    { "pattern": "aveezahvaganza.com", "custom_domain": true },
    { "pattern": "www.aveezahvaganza.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
